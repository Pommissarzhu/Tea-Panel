<Window x:Class="TeaPanel.ReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="茶伴 · 泡茶提醒" Width="460" Height="320" WindowStyle="None" ResizeMode="NoResize"
    AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
    Topmost="True" FontFamily="{StaticResource TeaFont}" UseLayoutRounding="True">
    <Border x:Name="PanelBody" Margin="10" Padding="25" CornerRadius="23" BorderBrush="#29FFFFFF" BorderThickness="1" MouseLeftButtonDown="OnDrag">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#284F40" Offset="0" /><GradientStop Color="#1F4538" Offset="1" /></LinearGradientBrush></Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.2" /></Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <Grid><TextBlock x:Name="PreviewLabel" Text="T E A  P A N E L" Foreground="#CCE0EDCF" FontSize="10" FontWeight="Medium" /><TextBlock x:Name="TeaLabel" Foreground="#CCE0EDCF" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="260" /></Grid>
            <Path x:Name="TeaSymbol" Width="35" Height="31" Fill="{StaticResource Pale}" Stretch="Uniform" Margin="0,19,0,0" />
            <TextBlock x:Name="ReminderTitle" Text="你的茶，泡好了" FontSize="28" FontWeight="Medium" Foreground="White" TextAlignment="Center" Margin="0,15,0,0" />
            <TextBlock x:Name="ReminderSubtitle" FontSize="13" Foreground="#D9E0EDCF" TextWrapping="Wrap" TextAlignment="Center" Margin="0,15,0,0" />
            <Button x:Name="ConfirmButton" Content="知道了，去喝茶" Background="{StaticResource Pale}" Foreground="{StaticResource Forest}" FontWeight="SemiBold" FontSize="14" Height="43" Margin="0,18,0,0" Click="OnConfirm" />
            <Grid Margin="0,15,0,0">
                <Button x:Name="EndButton" Content="结束本轮" Background="Transparent" Foreground="#B3E0EDCF" FontSize="11" Click="OnEnd" Visibility="Collapsed" />
                <TextBlock x:Name="FooterText" Text="静音提醒 · 等你处理后再收起" Foreground="#99E0EDCF" FontSize="10" TextAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
